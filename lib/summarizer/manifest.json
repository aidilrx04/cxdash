{
	"manifest_version": 3,
	"name": "Executive Summary Orchestrator",
	"version": "1.0",
	"description": "Orchestrates NotebookLM, DeepSeek, and PAPS local report generation.",
	"permissions": [
		"tabs",
		"scripting",
		"storage",
		"unlimitedStorage"
	],
	"host_permissions": [
		"http://localhost:8000/*",
		"https://localhost:8000/*",
		"https://notebook.google.com/*",
		"https://chat.deepseek.com/*",
		"https://pgtraining-admin.peopleaps.com/*"
	],
	"externally_connectable": {
		"matches": [
			"http://localhost:8000/*",
			"http://localhost/*",
			"http://127.0.0.1/*",
			"http://paps.local:5123/*"
		]
	},
	"background": {
		"service_worker": "service-worker.js"
	},
	"content_scripts": [
		{
			"matches": [
				"http://localhost:8000/*"
			],
			"js": [
				"content-origin.js"
			]
		},
		{
			"matches": [
				"https://notebook.google.com/*"
			],
			"js": [
				"content-notebook.js"
			]
		},
		{
			"matches": [
				"https://chat.deepseek.com/*"
			],
			"js": [
				"content-deepseek.js"
			]
		},
		{
			"matches": [
				"https://pgtraining-admin.peopleaps.com/*"
			],
			"js": [
				"content-paps.js"
			]
		}
	]
}